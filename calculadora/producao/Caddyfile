# Porteiro da calculadora em produção (Fly.io).
# Só passa quem mandar o cabeçalho  Authorization: Bearer <MOTOR_CHAVE>.
{
	admin off
	auto_https off
}

:8000 {
	# Saúde: sem chave, para o Fly.io saber se está vivo.
	handle /saude {
		rewrite * /health
		reverse_proxy 127.0.0.1:9101
	}

	@autorizado header Authorization "Bearer {$MOTOR_CHAVE}"
	handle @autorizado {
		reverse_proxy 127.0.0.1:8080
	}

	handle {
		respond "Acesso negado" 401
	}
}
