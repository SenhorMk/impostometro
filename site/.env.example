# O site não precisa de nenhuma variável para calcular: a calculadora roda
# dentro do próprio site (porte em TypeScript, pasta src/motor/).
# Para indexação: endereço HTTPS público, sem caminho (decisão do T04).
# Deixar vazio mantém noindex e robots bloqueado. Prévias também ficam bloqueadas.
SITE_URL=
# Registro opcional de buscas sem resultado. Usadas somente no servidor.
# Chave publicável: a tabela permite apenas inserir; leitura exige administração.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
#
# Só para conferir o porte contra a calculadora oficial (npm run porte:comparar):
# endereço da calculadora oficial em Docker. Padrão: http://localhost:8080/api/calculadora
CALCULADORA_URL=
#
# Assinatura (T14). Todas só no servidor (Vercel). Sem ASAAS_API_KEY e
# SUPABASE_SECRET_KEY, a cobrança fica desligada e /importar segue aberta como prévia.
# Chave SECRETA do Supabase (sb_secret_...): grava a assinatura. Nunca no navegador.
SUPABASE_SECRET_KEY=
# Chave da API do Asaas (a do sandbox é diferente da de produção).
ASAAS_API_KEY=
# sandbox (padrão) ou producao
ASAAS_AMBIENTE=
# Token que você inventa e cola também no webhook do Asaas (cabeçalho asaas-access-token).
ASAAS_WEBHOOK_TOKEN=
# Opcional: preço em centavos (padrão 2900). Use 100 só para o teste real de R$ 1.
ASSINATURA_PRECO_CENTAVOS=
